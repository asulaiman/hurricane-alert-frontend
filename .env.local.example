# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Postgres connection string. For local dev, a local Postgres works fine
# (e.g. postgresql://localhost/hurricane_alert_dev). In production, use a
# Neon (neon.tech) connection string — free tier is enough to start.
DATABASE_URL=

# Resend (resend.com) — free tier covers 100 emails/day. Requires verifying
# a sending domain (SPF/DKIM) before RESEND_FROM will actually deliver.
RESEND_API_KEY=
RESEND_FROM=alerts@yourdomain.com

# Required in every advisory email footer for CAN-SPAM compliance.
MAILING_ADDRESS=Your Company, 123 Main St, City, ST 00000

# Web push. Generate once with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY exactly (client needs it too).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
VITE_VAPID_PUBLIC_KEY=

# Sent as the User-Agent when calling api.weather.gov — NWS asks for a way to
# reach you, e.g. "hurricane-alert (you@yourdomain.com)".
NWS_CONTACT=hurricane-alert (you@yourdomain.com)

# Shared secret the GitHub Actions cron workflow sends as
# "Authorization: Bearer $CRON_SECRET" — generate any long random string.
CRON_SECRET=

# Public URL of the deployed app; used to build links in emails and as the
# push notification click-through target. Falls back to the request's Host
# header locally, but should be set explicitly once deployed.
APP_BASE_URL=http://localhost:5173
